# 复制为 .env 后按需修改。所有键与 rag_core/settings.py 一一对应。

# --- PostgreSQL ---
POSTGRES_USER=finance_rag
POSTGRES_PASSWORD=finance_rag_dev
POSTGRES_DB=finance_rag
DATABASE_URL=postgresql+asyncpg://finance_rag:finance_rag_dev@localhost:5432/finance_rag

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=finance-rag-docs
MINIO_SECURE=false

# --- SiliconFlow（embedding + rerank） ---
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# --- LLM（LiteLLM） ---
LLM_MODEL=deepseek/deepseek-chat
DEEPSEEK_API_KEY=
